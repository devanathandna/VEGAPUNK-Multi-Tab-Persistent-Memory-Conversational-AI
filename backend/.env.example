# VEGAPUNK Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
DEBUG=True

# Groq API Configuration
# Get your free API keys from: https://console.groq.com
# All keys use the same model: llama-3.1-8b-instant
GROQ_API_KEY_1=your_main_key_here
GROQ_API_KEY_2=your_classifier_key_here
GROQ_API_KEY_3=your_entity_user_key_here
GROQ_API_KEY_4=your_entity_model_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Session Configuration
SECRET_KEY=your_secret_key_change_this_in_production

# Logging
LOG_LEVEL=INFO
